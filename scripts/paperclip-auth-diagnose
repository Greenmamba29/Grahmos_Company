#!/usr/bin/env python3

import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from paperclip_common import run_api


def main():
    company_id = os.environ.get("PAPERCLIP_COMPANY_ID")
    agent_id = os.environ.get("PAPERCLIP_AGENT_ID")

    checks = [
        ("session", "/auth/get-session"),
    ]
    if company_id:
        checks.append(
            (
                "assigned_issues",
                f"/companies/{company_id}/issues?assigneeAgentId={agent_id or ''}&limit=1",
            )
        )

    results = {
        "paperclip_api_url_present": bool(os.environ.get("PAPERCLIP_API_URL")),
        "paperclip_company_id_present": bool(company_id),
        "paperclip_agent_id_present": bool(agent_id),
        "auth_header_present": bool(os.environ.get("PAPERCLIP_AUTH_HEADER")),
        "cookie_header_present": bool(os.environ.get("PAPERCLIP_COOKIE_HEADER")),
        "checks": {},
    }

    for name, path in checks:
        try:
            response = run_api("GET", path, print_errors=False)
            if isinstance(response, list):
                summary = {"ok": True, "type": "list", "count": len(response)}
            elif isinstance(response, dict):
                summary = {
                    "ok": True,
                    "type": "object",
                    "keys": sorted(response.keys())[:20],
                }
            else:
                summary = {"ok": True, "type": type(response).__name__}
        except SystemExit as exc:
            summary = {"ok": False, "exit_code": exc.code}
        results["checks"][name] = summary

    results["auth_ready"] = all(
        (
            results["paperclip_api_url_present"],
            results["paperclip_company_id_present"],
            results["paperclip_agent_id_present"],
            results["checks"].get("session", {}).get("ok", False),
            results["checks"].get("assigned_issues", {}).get("ok", False),
        )
    )
    if results["auth_ready"]:
        results["recommended_next_steps"] = [
            "./scripts/paperclip-issue-update --comment \"Heartbeat: resumed work from an authenticated shell.\" --status in_progress",
            "./scripts/paperclip-issue-interaction --print-example request_confirmation",
            "./scripts/paperclip-blocked-update --reason \"<reason>\" --owner \"<owner>\" --action \"<action>\"",
        ]
        results["command_templates"] = {
            "resume_heartbeat": "./scripts/paperclip-issue-update --comment \"Heartbeat: resumed work from an authenticated shell.\" --status in_progress",
            "blocked_update": "./scripts/paperclip-blocked-update --reason \"<reason>\" --owner \"<owner>\" --action \"<action>\"",
        }
    else:
        results["recommended_next_steps"] = [
            "Inject PAPERCLIP_AUTH_HEADER or PAPERCLIP_COOKIE_HEADER into the runtime.",
            "Re-run ./scripts/paperclip-auth-diagnose until auth_ready is true.",
            "Then use the issue helpers to post the required comment, interaction, or final status update.",
        ]
        results["command_templates"] = {
            "recheck_auth": "./scripts/paperclip-auth-diagnose",
            "blocked_update_after_auth": "./scripts/paperclip-blocked-update --reason \"Paperclip board auth is unavailable from the cloud shell.\" --owner \"Paperclip platform/operator\" --action \"Inject a valid PAPERCLIP_AUTH_HEADER or PAPERCLIP_COOKIE_HEADER into the runtime.\" --evidence \"Direct /api requests returned 401 Unauthorized and Board authentication required.\"",
        }

    print(json.dumps(results, indent=2))


if __name__ == "__main__":
    main()
